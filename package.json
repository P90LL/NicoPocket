{
  "name": "nicopocket",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.content.json --noEmit",
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "verify:browser": "npm run build && node scripts/verify-browser.mjs",
    "verify:media": "npm run build && node scripts/verify-browser.mjs --media"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/chrome": "0.3.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
