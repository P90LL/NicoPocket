{
    "manifest_version": 3,
    "name": "nico downloader",
    "description": "ニコニコからの動画保存をサポートする他、ニコニコを便利に使うための非公式の拡張機能です。",
    "version": "5.0.0.21",
    "icons": {
        "16": "icon_16.png",
        "48": "icon_48.png",
        "128": "icon_128.png"
    },
    "permissions": [
        "storage",
        "downloads"
    ],
    "host_permissions": [
        "https://nicovideo.cdn.nimg.jp/*",
        "https://tn.smilevideo.jp/*"
    ],
    "web_accessible_resources": [
        {
            "matches": [
                "https://www.nicovideo.jp/*"
            ],
            "resources": [
                "options.html",
                "dist/ffmpeg-core2.js",
                "dist/ffmpeg-core.wasm",
                "dist/utils.js",
                "func/nicojson.js",
                "func/ndl.js"
            ]
        }
    ],
    "content_scripts": [
        {
            "matches": ["https://www.nicovideo.jp/*"],
            "js": ["pocket/title.js", "pocket/content.js"],
            "css": ["pocket/content.css"],
            "run_at": "document_start"
        },
        {
            "matches": [
                "https://www.nicovideo.jp/*"
            ],
            "js": [
                "nicovideodownloader_scripts.js",
                "options.js",
                "dist/ffmpeg-core2.js",
                "dist/utils.js",
                "func/nicojson.js",
                "func/ndl.js",
                "pocket/metadata.js",
                "pocket/audio-quality.js",
                "pocket/video-info.js",
                "pocket/aac-bridge.js"
            ]
        },
        {
            "matches": [
                "https://dic.nicovideo.jp/*"
            ],
            "js": [
                "dic_scripts.js",
                "options.js"
            ]
        }
    ],
    "background": {
        "service_worker": "pocket/background.js"
    },
    "options_page": "options.html"
}